#!/bin/sh

set -eu

step="${2:-5}"

if command -v brightnessctl >/dev/null 2>&1; then
  case "${1:-}" in
    up)
      brightnessctl set "+${step}%" >/dev/null
      ;;
    down)
      brightnessctl set "${step}%-" >/dev/null
      ;;
    *)
      echo "Usage: teamos-brightnessctl {up|down} [step-percent]" >&2
      exit 1
      ;;
  esac

  current="$(brightnessctl -m | awk -F',' '{print $4}')"
  dunstify -u low -h string:x-dunst-stack-tag:teamos-brightness "Brightness" "$current" 2>/dev/null || true
  exit 0
fi

if command -v xbacklight >/dev/null 2>&1; then
  case "${1:-}" in
    up)
      xbacklight -inc "$step"
      ;;
    down)
      xbacklight -dec "$step"
      ;;
    *)
      echo "Usage: teamos-brightnessctl {up|down} [step-percent]" >&2
      exit 1
      ;;
  esac

  current="$(xbacklight -get | awk '{printf("%.0f%%", $1)}')"
  dunstify -u low -h string:x-dunst-stack-tag:teamos-brightness "Brightness" "$current" 2>/dev/null || true
  exit 0
fi

echo "No brightness backend found (brightnessctl or xbacklight)." >&2
exit 1