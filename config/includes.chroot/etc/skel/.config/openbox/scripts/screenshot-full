#!/bin/sh

outdir="$HOME/Pictures"
mkdir -p "$outdir"

fname="screenshot-$(date +%Y%m%d-%H%M%S).png"
outfile="$outdir/$fname"

if command -v scrot >/dev/null 2>&1; then
  exec scrot "$outfile"
fi

if command -v import >/dev/null 2>&1; then
  exec import -window root "$outfile"
fi

echo "No screenshot tool found (need scrot or import)." >&2
exit 1
