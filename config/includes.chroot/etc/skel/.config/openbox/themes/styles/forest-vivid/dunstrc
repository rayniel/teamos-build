[global]
monitor = 0
follow = mouse
width = 320
height = 96
origin = top-right
offset = 18x56
scale = 0
notification_limit = 6
progress_bar = true
progress_bar_height = 8
progress_bar_frame_width = 1
progress_bar_min_width = 140
progress_bar_max_width = 320
indicate_hidden = yes
transparency = 0
separator_height = 2
padding = 12
horizontal_padding = 12
text_icon_padding = 10
frame_width = 2
gap_size = 8
frame_color = "#8cff9d"
separator_color = frame
sort = yes
font = Source Sans 3 10
line_height = 1
markup = full
format = "<b>%s</b>\\n%b"
alignment = left
vertical_alignment = center
show_age_threshold = 60
ellipsize = middle
ignore_newline = no
stack_duplicates = true
hide_duplicate_count = false
show_indicators = yes
icon_position = left
max_icon_size = 40
sticky_history = yes
history_length = 20
browser = xdg-open
always_run_script = true
title = Dunst
class = Dunst
corner_radius = 12
ignore_dbusclose = false
mouse_left_click = close_current
mouse_middle_click = do_action, close_current
mouse_right_click = close_all

[urgency_low]
timeout = 3
background = "#0a130d"
foreground = "#f1fff4"
frame_color = "#46a35a"

[urgency_normal]
timeout = 6
background = "#0a130d"
foreground = "#f1fff4"
frame_color = "#8cff9d"

[urgency_critical]
timeout = 0
background = "#261612"
foreground = "#ffece6"
frame_color = "#ff8f73"
