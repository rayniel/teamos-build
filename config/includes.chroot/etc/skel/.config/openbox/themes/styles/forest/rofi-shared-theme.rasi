* {
  bg: #0f1712e8;
  bg-alt: #15231add;
  surface: #1e3427dd;
  fg: #eef7ed;
  fg-dim: #9eb4a0;
  accent: #7adf88;
  accent-strong: #55bc64;
  urgent: #e07a61;
  border: #3d6545;
  selected: #274632ee;

  background-color: transparent;
  text-color: @fg;
  font: "Source Sans 3 11";
}

window {
  border: 2px;
  border-radius: 18px;
  border-color: @border;
  background-color: @bg;
}

mainbox {
  spacing: 14px;
  padding: 16px;
  background-color: transparent;
}

inputbar {
  spacing: 8px;
  padding: 12px;
  border-radius: 12px;
  background-color: @surface;
}

entry {
  placeholder-color: @fg-dim;
}

listview {
  cycle: true;
  dynamic: true;
  scrollbar: false;
  spacing: 8px;
  background-color: transparent;
}

element {
  padding: 12px;
  border-radius: 12px;
  background-color: transparent;
}

element normal.normal {
  text-color: @fg;
}

element selected.normal {
  background-color: @selected;
  border: 1px;
  border-color: @accent;
  text-color: @fg;
}

element-icon {
  size: 1.1em;
  vertical-align: 0.5;
}

element-text {
  vertical-align: 0.5;
}

message {
  enabled: true;
  background-color: transparent;
  text-color: @fg-dim;
}

button {
  padding: 7px 12px;
  border-radius: 11px;
  background-color: @surface;
  text-color: @fg;
}

button selected {
  background-color: @accent;
  text-color: #08100a;
}
