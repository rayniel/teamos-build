* {
  bg: #0a130de6;
  bg-alt: #122018d8;
  surface: #173225d8;
  fg: #f1fff4;
  fg-dim: #9fc8aa;
  accent: #8cff9d;
  accent-strong: #5fe874;
  urgent: #ff8f73;
  border: #46a35a;
  selected: #1e5030ee;

  background-color: transparent;
  text-color: @fg;
  font: "Source Sans 3 11";
}

window {
  border: 2px;
  border-radius: 20px;
  border-color: @border;
  background-color: @bg;
}

mainbox {
  spacing: 14px;
  padding: 18px;
  background-color: transparent;
}

inputbar {
  spacing: 8px;
  padding: 13px;
  border-radius: 14px;
  background-color: @surface;
}

entry {
  placeholder-color: @fg-dim;
}

listview {
  cycle: true;
  dynamic: true;
  scrollbar: false;
  spacing: 8px;
  background-color: transparent;
}

element {
  padding: 12px;
  border-radius: 14px;
  background-color: transparent;
}

element normal.normal {
  text-color: @fg;
}

element selected.normal {
  background-color: @selected;
  border: 1px;
  border-color: @accent;
  text-color: @fg;
}

element-icon {
  size: 1.1em;
  vertical-align: 0.5;
}

element-text {
  vertical-align: 0.5;
}

message {
  enabled: true;
  background-color: transparent;
  text-color: @fg-dim;
}

button {
  padding: 8px 13px;
  border-radius: 12px;
  background-color: @surface;
  text-color: @fg;
}

button selected {
  background-color: @accent;
  text-color: #071009;
}
