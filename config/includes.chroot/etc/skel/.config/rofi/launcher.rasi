@import "shared-theme"

window {
  width: 34%;
  location: north;
  anchor: north;
  x-offset: 0px;
  y-offset: 58px;
}

mainbox {
  children: [inputbar, message, listview, mode-switcher];
}

inputbar {
  children: [prompt, entry];
}

prompt {
  text-color: @accent;
  str: "Launch";
}

entry {
  placeholder: "Search apps, actions, and files...";
}

listview {
  columns: 1;
  lines: 10;
}

mode-switcher {
  spacing: 8px;
  background-color: transparent;
}