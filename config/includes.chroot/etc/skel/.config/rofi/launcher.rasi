@import "shared-theme"

window {
  width: 30%;
  location: north;
  anchor: north;
  x-offset: 0px;
  y-offset: 52px;
}

mainbox {
  children: [inputbar, message, listview, mode-switcher];
}

inputbar {
  children: [prompt, entry];
}

prompt {
  text-color: @accent;
  str: "Applications";
}

entry {
  placeholder: "Search installed applications...";
}

listview {
  columns: 1;
  lines: 12;
}

mode-switcher {
  spacing: 8px;
  background-color: transparent;
}